{
  "name": "@abc-protocol/worker-extension",
  "version": "0.2.0",
  "description": "Worker extension server: run commands and read/write files in ONE fixed remote easyworker sandbox (worker-url + worker-token). The stable single-worker variant; see workspace-extension for dynamic sandboxes + git.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "manifest.yaml"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly && node scripts/bundle.mjs",
    "check": "biome check .",
    "test": "vitest run",
    "check:fix": "biome check --fix .",
    "check:types": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@abc-protocol/sdk": "github:abcp-sdk/abc-protocol-typescript#v3.7.0",
    "@bufbuild/protobuf": "^2.15.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
