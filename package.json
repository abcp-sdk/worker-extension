{
  "name": "@abc-protocol/worker-extension",
  "version": "0.1.0",
  "description": "Worker extension server: run commands and read/write files in ONE fixed remote easyworker sandbox (worker-url + worker-token). The stable single-worker variant; see workspace-extension for dynamic sandboxes + git.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly && node scripts/bundle.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@abc-protocol/sdk": "github:abcp-sdk/abc-protocol-typescript#v3.5.2",
    "@bufbuild/protobuf": "^2.15.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
